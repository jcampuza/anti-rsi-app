{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anti RSI",
  "version": "0.1.0",
  "identifier": "com.josephcampuzano.antirsi",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5733",
    "beforeDevCommand": "bun run build:sidecar && bun run dev:web",
    "beforeBuildCommand": "bun run build:sidecar && bun run build:web"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/antirsi-sidecar"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
