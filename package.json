{
  "name": "@antirsi/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@types/node": "^22.20.0",
    "vite-plus": "0.2.1",
    "vitest": "4.1.9"
  },
  "scripts": {
    "dev": "bun run --cwd apps/tauri dev",
    "dev:web": "PORT=5733 bun run --cwd apps/web dev -- --host 127.0.0.1",
    "build": "vp run --filter './packages/*' build && bun run build:tauri",
    "build:web": "vp run --filter @antirsi/web build",
    "build:tauri": "bun run --cwd apps/tauri build",
    "typecheck": "vp run -r typecheck",
    "lint": "eslint --cache .",
    "test": "vp run -r test",
    "package": "bun run build:tauri",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "^9.39.4",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
    "vitest": "4.1.9"
  }
}
